class Solution {
    fun strStr(haystack: String, needle: String): Int {
        val lastPossibleIndex = haystack.length - needle.length

        return (0..lastPossibleIndex)
            .firstOrNull { index ->
                haystack.startsWith(needle, index)
            } ?: -1
    }
}

